# --- Instagram (Meta) ---
# Токен Instagram-аккаунта (Instagram API with Instagram Login), права instagram_business_manage_messages
IG_ACCESS_TOKEN=
# App Secret из настроек приложения Meta (для проверки подписи вебхуков)
IG_APP_SECRET=
# Любая строка, которую вы придумаете и впишете в настройках вебхука в Meta
IG_VERIFY_TOKEN=twinstone_verify_123
IG_API_VERSION=v21.0

# --- ИИ (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Telegram (уведомления менеджерам о заявках, необязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Поведение ---
PORT=3000
# Сколько часов бот молчит в чате, если туда написал живой менеджер или клиент попросил менеджера
HUMAN_PAUSE_HOURS=12
